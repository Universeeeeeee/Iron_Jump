# Append these to the project's existing .env; do not replace its LLM settings.
# API Key from the NEW speech console; this is NOT an Ark/DeepSeek/OpenAI key.
VOLC_SPEECH_API_KEY=
# Optional separate keys; omit these if both services share the key above.
# VOLC_ASR_API_KEY=
# VOLC_TTS_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# Optional PortAudio device indexes from: python -m voice --devices
# VOICE_INPUT_DEVICE=
# VOICE_OUTPUT_DEVICE=
