            "unit": "LED数",
            "default": 0,
            "applicable_tests": [
              "Treadmill Running Test",
              "Treadmill Gait Test"
            ],
            "source": "4.2.2.5/5.1.6",
            "priority": "core"
          },
          {
            "name": "filter_gaitr_out",
            "display_name": "GaitR出过滤器 Filter GaitR OUT",
            "description": "判定离开接触所需的最小连续中断LED数量",
            "type": "integer",
            "unit": "LED数",
            "default": 0,
            "applicable_tests": [
              "Treadmill Running Test",
              "Treadmill Gait Test"
            ],
            "source": "4.2.2.5/5.1.6",
            "priority": "core"
          },
          {
            "name": "automatic_data_filter",
            "display_name": "自动数据过滤 Automatic Data Filter",
