            "type": "float",
            "unit": "cm",
            "default": 10.0,
            "applicable_tests": [
              "Sprint and Gait Test",
              "Treadmill Running Test",
              "Tapping Test"
            ],
            "source": "4.2.2.4/4.4.1.5",
            "priority": "core"
          },
          {
            "name": "min_step_length",
            "display_name": "最小步长 Minimum Step Length",
            "description": "跑步机步态测试使用的最小步长过滤参数",
            "type": "float",
            "unit": "cm",
            "default": 10.0,
            "applicable_tests": [
              "Treadmill Gait Test"
            ],
            "source": "4.2.2.6",
            "priority": "core"
          },
          {
            "name": "min_foot_length",
            "display_name": "最小足长 Minimum Foot Length",
            "description": "用于过滤异常采集的最小足长阈值",
            "type": "float",
            "unit": "cm",
            "applicable_tests": [
              "Sprint and Gait Test",
              "Treadmill Running Test",
              "Treadmill Gait Test",
              "Tapping Test"
            ],
            "source": "4.2.2.4/4.4.1.5",
            "priority": "core"
          },
          {
            "name": "entry_point",
            "display_name": "进入方向 Entry Point",
            "description": "运动员进入测试区域的方向",
            "type": "enum",
            "values": [
              "Interface side",
              "Opposite side",
              "Automatic"
            ],
            "default": "Automatic",
            "applicable_tests": [
              "Sprint and Gait Test"
            ],
            "source": "4.2.2.4/4.4.1.5",
            "priority": "core"
          },
          {
            "name": "consider_first_step",
