              "Yes",
              "No"
            ],
            "default": "Yes",
            "applicable_tests": [
              "Sprint and Gait Test"
            ],
            "source": "4.2.2.4",
            "priority": "core"
          },
          {
            "name": "filter_gaitr_in",
            "display_name": "GaitR进过滤器 Filter GaitR IN",
