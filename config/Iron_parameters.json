            ],
            "source": "4.2.2.6",
            "priority": "optional"
          }
        ]
      },
      {
        "name": "Sprint 专有次级参数",
        "parameters": [
          {
            "name": "test_timeout",
            "display_name": "测试超时 Test Timeout",
