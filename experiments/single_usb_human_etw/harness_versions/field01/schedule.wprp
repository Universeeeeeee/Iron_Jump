<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="IronJump experiment">
  <Profiles>
    <SystemCollector Id="ScheduleCollector" Name="IronJumpSchedule">
      <BufferSize Value="64" />
      <Buffers Value="128" />
    </SystemCollector>
    <SystemProvider Id="ScheduleProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
    </SystemProvider>
    <Profile Id="IronJumpSchedule.Verbose.File" Name="IronJumpSchedule" Description="Thread scheduling only, no stacks or sampled profile" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="ScheduleCollector">
          <SystemProviderId Value="ScheduleProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
